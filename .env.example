# Copy to .env for local development. On Render, add these under Environment.
PORT=4000
# MongoDB Atlas connection string (Atlas > Connect > Drivers)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/tradepursuit?retryWrites=true&w=majority
# Long random string: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
# Comma-separated frontend URLs allowed to call this API. * works as a wildcard.
CLIENT_ORIGIN=http://localhost:5173,https://trade-pursuit.vercel.app,https://trade-pursuit-*.vercel.app

